# Copy to compute.env (repo root) and fill in. compute.env is gitignored; never commit keys.
# The vendored harness finds this file by walking up from its own directory.

# Inference. We route everything through OpenRouter (it serves Claude, Kimi, DeepSeek, GPT).
OPENROUTER_API_KEY=

# Leave empty unless you have Nebius credits. NOTE: if this is set, the harness sends ALL calls to
# Nebius, which does not serve Claude. Keep it empty for this project.
NEBIUS_API_KEY=

# Do NOT set LLM_MODEL. It forces one model into every seat, judge and overseer and silently
# collapses heterogeneous runs into single-model runs.
